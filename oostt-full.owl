        <obo:IAO_0000115 xml:lang="en">A plan specification that specifies the job requirements for the trauma surgeon positions in an institution and how those trauma surgeons will be used within the organization.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Jonathan Bona</obo:IAO_0000117>
