            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A plan specification that has a trauma system creation objective as a part and that specifies the necessary processes to achieve that objective.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000117 xml:lang="en">Sarah Bost</obo:IAO_0000117>
        <obo:OOSTT_00000030 xml:lang="en">The plan describing the process for creation of a trauma system.</obo:OOSTT_00000030>
        <rdfs:label xml:lang="en">trauma system creation plan specification</rdfs:label>
    </owl:Class>
    


