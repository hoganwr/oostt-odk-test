    <!-- http://purl.obolibrary.org/obo/OMRSE_00000010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OMRSE_00000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000024"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00002072"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
