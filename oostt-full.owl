        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A function that inheres in a material entity and, if realized, is realized by protecting persons and their possessions from weather and by some person or group of persons habitually sleeping in at least one site that is contained by that material entity.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Amanda Hicks</obo:IAO_0000117>
        <rdfs:label xml:lang="en">residence function</rdfs:label>
    </owl:Class>
    


