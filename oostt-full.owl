    <!-- http://purl.obolibrary.org/obo/OOSTT_00000384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that reports a patient&apos;s injuries assessing nine body regions and scoring injuries on a six point scale.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Emma Chappell</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">AIS code</obo:IAO_0000118>
