        <obo:IAO_0000118 xml:lang="en">paramedic services</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">https://www.ems.gov/whatisems.html</obo:IAO_0000119>
        <rdfs:label xml:lang="en">emergency medical services system</rdfs:label>
    </owl:Class>
    


