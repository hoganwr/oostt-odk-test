        <obo:IAO_0000115 xml:lang="en">A plan specification that specifies planned income and expenses for a person or an organization for a specified period of time.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">John Judkins</obo:IAO_0000117>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:OOSTT_00000030 xml:lang="en">A detailed plan identifying the sources of revenue and allocation of funds for a designated period of time.</obo:OOSTT_00000030>
        <rdfs:label xml:lang="en">budget</rdfs:label>
    </owl:Class>
    


