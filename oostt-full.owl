        <rdfs:comment xml:lang="en">Housing units are individuated by their residence functions.</rdfs:comment>
        <rdfs:label xml:lang="en">housing unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OMRSE_00000075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OMRSE_00000075">
