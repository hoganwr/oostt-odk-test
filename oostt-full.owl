    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000385 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <obo:IAO_0000115 xml:lang="en">An identifier specifying the name and version of a software that calculates abbreviated injury scale severity codes.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Emma Chappell</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2024. https://www.facs.org/media/k4wnvapp/final_2024-data-dictionary-830.pdf</obo:IAO_0000119>
        <obo:OOSTT_00000030 xml:lang="en">AIS Version</obo:OOSTT_00000030>
        <rdfs:label xml:lang="en">abbreviated injury scale version identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000386 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000386">
