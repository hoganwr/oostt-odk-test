            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A bacterial urinary tract infection that is caused when an organism has a catheter in place.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Emma Chappell</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2024. https://www.facs.org/media/k4wnvapp/final_2024-data-dictionary-830.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">catheter related urinary tract infection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000391 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000391">
