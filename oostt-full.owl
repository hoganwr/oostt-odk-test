    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000317">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000271"/>
        <obo:IAO_0000115 xml:lang="en">A governmental agency that evaluates healthcare provider organizations, which are candidates for acquiring a trauma center role, and reports as an outcome whether the organization is fit to be a trauma center.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">trauma center verification government agency</obo:IAO_0000118>
        <rdfs:label xml:lang="en">trauma center verification governmental agency</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000318 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <obo:IAO_0000115 xml:lang="en">A plan specification that specifies how members of emergency medical services agenies are supposed to acquire medical direction, when direct communication with medical providers is not available.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">emergency medical services offline medical direction protocol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000319 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000319">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <obo:IAO_0000115 xml:lang="en">A plan specification that specifies when members of emergency medical services agenies are required to try to set up direct conversation with other healthcare providers to give medical direction.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">emergency medical services online medical direction guideline</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000320 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000320">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000322"/>
        <obo:IAO_0000115 xml:lang="en">A trauma system participation incentive plan specification that specifies the availability of funding the local, regional, state or national government for trauma centers joining a trauma system.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">trauma system participation direct incentive plan specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000321 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000321">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000322"/>
        <obo:IAO_0000115 xml:lang="en">A trauma system participation incentive plan specification that specifies indirect incentives to motivate trauma centers to participate in a trauma system. Examples of such incentives are additional billing codes, remuneration for trauma team response, and availability of training opportunities.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">trauma system participation indirect incentive plan specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000322 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A plan specification that specifies resources that become available to trauma centers if they participate in a trauma system.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">trauma system participation incentive plan specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000325 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000325">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000115 xml:lang="en">A role that is borne by a human being and that, if realized, is realized by its bearer providing direction to the a trauma program and coordinate the activities of the program as organizational members.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">trauma program leadership role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000326 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000326">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000130"/>
        <obo:IAO_0000115 xml:lang="en">An anesthesiologist role that is the outcome of fullfilling all obligations to be allowed to take a board certification exam in anesthesiology.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">board eligible anesthesiologist role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000130"/>
        <obo:IAO_0000115 xml:lang="en">An anesthesiologist role that is the specified output of a board certification process and that, if realized is realized, is realized either by administering medication for the temporary general or local suppression of sensory or motor nerve function during some health care encounter or providing airway management or by making decisions independently of a supervising physician regarding the adminstration of such medication.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">board certified anesthesiologist role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000328 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000231"/>
        <obo:IAO_0000115 xml:lang="en">A collection of anesthesiologist on trauma service whose members are bearers of a board certified anesthesiologist role.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000117 xml:lang="en">Sarah Bost</obo:IAO_0000117>
        <rdfs:label xml:lang="en">collection of board certified anesthesiologists on trauma service</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000329">
        <rdfs:subClassOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#ObsoleteClass"/>
        <obo:IAO_0000115 xml:lang="en">A collection of humans that consists only of bearers of a board certified neurosurgeon role.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000103"/>
        <rdfs:label xml:lang="en">obsolete_collection of board certified neurosurgeons</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000331 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000108"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000846"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000127"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000153"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An emergency department representative role that is borne by a member of the medical team of an emergency department and that, if realized, is realized by its bearer serving as the point of contact for all quality improvement-related communication between the emergency department and the trauma program.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000117>Sarah Bost</obo:IAO_0000117>
        <obo:OOSTT_00000030 xml:lang="en">An member of the medical team of an emergency department who serves as the formal point of contact for the trauma program for all quality improvement-related issues regarding trauma care within the ED.</obo:OOSTT_00000030>
        <rdfs:label xml:lang="en">emergency department quality improvement liaison to trauma program role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000332 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000332">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000195"/>
        <obo:IAO_0000115 xml:lang="en">A general surgeon role that is the specified output of a board certification process and that, if realized, is realized by its bearer using operative manual and instrumental techniques on a patient to investigate or treat a pathological condition such as disease or injury, to help improve bodily function or appearance or to repair unwanted ruptured areas without the bearer of the role specializing into any particular field of surgery.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Sarah Bost</obo:IAO_0000117>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/oostt/release/2025-08-28/oostt.owl</obo:IAO_0000412>
        <obo:OOSTT_00000030 xml:lang="en">A physician who has completed a general surgery residency program and achieved board certification.</obo:OOSTT_00000030>
        <rdfs:label xml:lang="en">board certified general surgeon role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000334 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000334">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000332"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A human that is the bearer of a board certified general surgeon and that has additional training, experience, and career focus in the care of injured patients.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Sarah Bost</obo:IAO_0000117>
        <rdfs:label xml:lang="en">board certified general surgeon with trauma concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000335 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000335">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000015"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A plan specification that specifies which anesthesiologist to call,  if the primary on-call anesthesiologist is not available due to already taking care of other trauma patients.</obo:IAO_0000115>
        <obo:IAO_0000117>Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">anesthesiologist backup call schedule</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000336 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/APOLLO_SV_00000243"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000098"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A duration that specifies the temporal extension of a hospital stay.</obo:IAO_0000115>
        <obo:IAO_0000117>Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">length of stay</obo:IAO_0000118>
        <rdfs:label xml:lang="en">hospitalization duration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000337 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000014"/>
        <obo:IAO_0000115 xml:lang="en">A clinical finding that occurs during the course of, or because of, another disease, treatment, or procedure. [Definition Source: NCI]</obo:IAO_0000115>
        <obo:IAO_0000117>Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">http://purl.obolibrary.org/obo/NCIT_C2959</obo:IAO_0000119>
        <rdfs:label xml:lang="en">complication finding</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000338 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a measurement of time used to describe a lifetime.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Diya Mehta</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2021. Accessed July 7, 2023 https://www.facs.org/media/ouzftbad/ntds_data_dictionary_2021.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">age unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000339 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0700096"/>
        <obo:IAO_0000115 xml:lang="en">A human disease that is borne by an organism and, if realized, is realized by the formation of a blood clot in the veins.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Diya Mehta</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2021. Accessed July 7, 2023 https://www.facs.org/media/ouzftbad/ntds_data_dictionary_2021.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">deep vein thrombosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000340 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <obo:IAO_0000115 xml:lang="en">A planned process that results in a drug report about an individual.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Diya Mehta</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2021. Accessed July 7, 2023 https://www.facs.org/media/ouzftbad/ntds_data_dictionary_2021.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">drug screening</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">A data item that specifies when an individual is released from the emergency department of a hospital.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Diya Mehta</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2021. Accessed July 7, 2023 https://www.facs.org/media/ouzftbad/ntds_data_dictionary_2021.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">emergency department discharge date</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000342 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that describes if an individual does not have a zip/postal code specifying their place of residence.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Diya Mehta</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2021. Accessed July 7, 2023 https://www.facs.org/media/ouzftbad/ntds_data_dictionary_2021.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">homeless status</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000343 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">An data item that is the outcome of an oxygen saturation measurement process that takes place no more than 30 minutes after admission to a healthcare provider.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Diya Mehta</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">initial oxygen saturation</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2021. Accessed July 7, 2023 https://www.facs.org/media/ouzftbad/ntds_data_dictionary_2021.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">initial oxygen saturation information after admission</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000344 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">A data item that is the outcome of a temperature measurement process that takes place no more than 30 minutes after admission to a healthcare provider.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Diya Mehta</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">initial temperature</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2021. Accessed July 7, 2023 https://www.facs.org/media/ouzftbad/ntds_data_dictionary_2021.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">initial temperature at admission</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000345 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is about an injury borne by a patient and that has an ICD code as a part.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Diya Mehta</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">ICD-10 injury diagnosis</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2021. Accessed July 7, 2023 https://www.facs.org/media/ouzftbad/ntds_data_dictionary_2021.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">international classification of diseases tenth revision injury diagnosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000346 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is the outcome of a person stating how they wish to compensate a due amount.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Diya Mehta</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2021. Accessed July 7, 2023 https://www.facs.org/media/ouzftbad/ntds_data_dictionary_2021.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">primary payment method information</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000347 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000422"/>
        <obo:IAO_0000115 xml:lang="en">A postal address that is about a residence a person is living in for a short period of time.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Diya Mehta</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2021. Accessed July 7, 2023 https://www.facs.org/media/ouzftbad/ntds_data_dictionary_2021.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">temporary address</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000348 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">A data item that specifies when a trauma surgeon arrived at the patient&apos;s bedside.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Diya Mehta</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2021. Accessed July 7, 2023 https://www.facs.org/media/ouzftbad/ntds_data_dictionary_2021.pdf</obo:IAO_0000119>
        <rdfs:label xml:lang="en">trauma surgeon arrival time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000349 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000349">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">A data item that provides the cumulative amount of time a patient spent in the ICU during one hospitalization measured in whole day increments.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary. 2024 Admissions. American College of Surgeons (ACS), Chicago, IL, 2023.</obo:IAO_0000119>
        <obo:OOSTT_00000324 xml:lang="en">Total ICU length of stay</obo:OOSTT_00000324>
        <rdfs:comment xml:lang="en">Each partial or full day must be measured as one calendar day.</rdfs:comment>
        <rdfs:label xml:lang="en">total intensive care unit length of stay data item</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000350 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000350">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <obo:IAO_0000115 xml:lang="en">A value specification that specifies the situation to which a patient is discharged after hospilaization, including the information that the patient passed away during hospitalization.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary. 2024 Admissions. American College of Surgeons (ACS), Chicago, IL, 2023.</obo:IAO_0000119>
        <obo:OOSTT_00000324 xml:lang="en">hospital discharge disposition</obo:OOSTT_00000324>
        <rdfs:label xml:lang="en">patient discharge disposition information</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000351 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000351">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <obo:IAO_0000115 xml:lang="en">A planned process consisting of chest compressions often combined with artificial ventilation, or mouth to mouth in an effort to manually preserve intact brain function until further measures are taken to restore spontaneous blood circulation and breathing in a person who is in cardiac arrest.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">CPR</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">https://en.wikipedia.org/w/index.php?title=Cardiopulmonary_resuscitation&amp;oldid=1193977417</obo:IAO_0000119>
        <rdfs:label xml:lang="en">cardiopulmonary resuscitation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000352 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000395"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002410"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCIT_C17612"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A bloodstream infection that is associated with the placing of a central line or an umbilical catheter in an organism.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Emma Chappell</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgions TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2024. https://www.facs.org/media/k4wnvapp/final_2024-data-dictionary-830.pdf</obo:IAO_0000119>
        <rdfs:comment xml:lang="en">Central venous access catheter is equivalent to central line</rdfs:comment>
        <rdfs:label xml:lang="en">central line associated bloodstream infection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000353 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000353">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBIB_0000716"/>
        <obo:IAO_0000115 xml:lang="en">An surgical procedure that was not part of the initial treatment plan.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:OOSTT_00000324 xml:lang="en">unplanned visit to the OR</obo:OOSTT_00000324>
        <rdfs:label xml:lang="en">unplanned surgical procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000354 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000354">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000201"/>
        <obo:IAO_0000115 xml:lang="en">An admission process through which a patient is admitted to the intensive care unit.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:OOSTT_00000324 xml:lang="en">ICU admission</obo:OOSTT_00000324>
        <rdfs:label xml:lang="en">intensive care unit admission process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000355 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000354"/>
        <obo:IAO_0000115 xml:lang="en">An intensive care unit admission process that was not part of the initial treatment plan.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:OOSTT_00000324 xml:lang="en">unplanned ICU admission</obo:OOSTT_00000324>
        <rdfs:label xml:lang="en">unplanned intensive care unit admission process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000356 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000023"/>
        <obo:IAO_0000115 xml:lang="en">A collection of humans consisting of humans that are receiving healthcare from one healthcare provider during a specified time.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">patient population</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000357 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000679"/>
        <obo:IAO_0000115 xml:lang="en">The average value (arithmetic mean) of the length of stay data of the patient population of an inpatient healthcare provider.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">mean length of stay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000358 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is about a person that is living in a  country they are not a citizen of without legal immigration or VISA paperwork.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Diya Mehta</obo:IAO_0000117>
        <rdfs:label xml:lang="en">undocumented person status</rdfs:label>
    </owl:Class>
    


