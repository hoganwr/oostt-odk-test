        <rdfs:comment xml:lang="en">Inspired by the NCIT definition</rdfs:comment>
        <rdfs:label xml:lang="en">surgical site infection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000392 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000391"/>
        <obo:IAO_0000115 xml:lang="en">A surgical site infection that occurs below the incision made during the procedure in the area of the muscles and the tissues that surround the muscles and occurs within a specified period of time.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Emma Chappell</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2024. https://www.facs.org/media/k4wnvapp/final_2024-data-dictionary-830.pdf</obo:IAO_0000119>
        <obo:IAO_0000119 xml:lang="en">https://www.hopkinsmedicine.org/health/conditions-and-diseases/surgical-site-infections#:~:text=Deep%20incisional%20SSI.,was%20involved%20in%20the%20surgery.</obo:IAO_0000119>
        <rdfs:label xml:lang="en">deep surgical site infection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000393 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000391"/>
        <obo:IAO_0000115 xml:lang="en">A surgical site infection that involves any part of the body deeper than the fascial/muscle layers, that was handled during the surgery and occurs within a specified period of time.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Emma Chappell</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgions TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2024. https://www.facs.org/media/k4wnvapp/final_2024-data-dictionary-830.pdf</obo:IAO_0000119>
        <obo:IAO_0000119 xml:lang="en">https://www.hopkinsmedicine.org/health/conditions-and-diseases/surgical-site-infections#:~:text=Deep%20incisional%20SSI.,was%20involved%20in%20the%20surgery.</obo:IAO_0000119>
        <rdfs:label xml:lang="en">organ/space surgical site infection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000394 -->

