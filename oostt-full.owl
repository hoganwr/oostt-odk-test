        </rdfs:subClassOf>
        <obo:IAO_0000115>An information content entity that is about the categorization of an individual&apos;s background as it is connected to a geographic region and the shared cultural practices of that region</obo:IAO_0000115>
        <obo:IAO_0000117>Emma Chappell</obo:IAO_0000117>
        <rdfs:label xml:lang="en">ethnic category information</rdfs:label>
    </owl:Class>
    


