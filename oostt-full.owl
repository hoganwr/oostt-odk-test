        <rdfs:subClassOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#ObsoleteClass"/>
        <obo:IAO_0000115 xml:lang="en">A plan specification that specifies the trauma system design with adopted standards of care for prehospital and hospital personnel and a process to regularly review the plan over time.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">https://www.facs.org/~/media/files/quality%20programs/trauma/tsepc/pdfs/regionaltraumasystems.ashx</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000227"/>
        <rdfs:label xml:lang="en">obsolete_trauma system plan</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


