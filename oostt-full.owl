    <!-- http://purl.obolibrary.org/obo/IAO_0000103 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000103">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000225"/>
        <obo:IAO_0000111 xml:lang="en">failed exploratory term</obo:IAO_0000111>
        <obo:IAO_0000115 xml:lang="en">The term was initially used in an attempt to structure part of the ontology, but in retrospect failed to do a good job.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Terms created as placeholders with the expectation of being permanent should instead be deprecated using the &quot;placeholder removed&quot; (obo:IAO_0000226) justification.</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">Person:Alan Ruttenberg</obo:IAO_0000117>
        <dc:contributor rdf:resource="https://orcid.org/0000-0001-6875-5360"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-7356-1779"/>
        <rdfs:label xml:lang="en">failed exploratory term</rdfs:label>
    </owl:NamedIndividual>
    


