        <obo:OOSTT_00000030 xml:lang="en">A planned process overseen by an authorized person or committee for development of prehospital practice guidelines regarding the assessment, management, and transport of patients with emergency conditions.</obo:OOSTT_00000030>
        <rdfs:label xml:lang="en">prehospital protocol development</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000055 -->

