        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2024. https://www.facs.org/media/k4wnvapp/final_2024-data-dictionary-830.pdf</obo:IAO_0000119>
        <obo:IAO_0000119 xml:lang="en">https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4871637/#:~:text=Bloodstream%20infections%20(BSI)%20are%20infectious,the%20alteration%20of%20clinical%2C%20laboratory</obo:IAO_0000119>
        <rdfs:label xml:lang="en">bloodstream infection</rdfs:label>
    </owl:Class>
    


