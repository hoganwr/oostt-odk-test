        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A collection of humans that only has bearers of an emergency physician role as members.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">collection of emergency physicians</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OOSTT_00000166 -->

