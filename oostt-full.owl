            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A data item that specifies the total amount of time a patient has spent on a machine that moves oxygen in and out of their lungs.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Emma Chappell</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">American College of Surgeons TCOT. National Trauma Data Standard Data Dictionary [Internet]. 2024. https://www.facs.org/media/k4wnvapp/final_2024-data-dictionary-830.pdf</obo:IAO_0000119>
