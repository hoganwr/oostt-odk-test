    <!-- http://purl.obolibrary.org/obo/MONDO_0006502 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0006502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001208"/>
        <obo:IAO_0000115>Progressive and life-threatening pulmonary distress in the absence of an underlying pulmonary condition, usually following major trauma or surgery. Cases of neonatal respiratory distress syndrome are not included in this definition.</obo:IAO_0000115>
        <obo:IAO_0000412>http://purl.obolibrary.org/obo/mondo/releases/2024-01-03/mondo.owl</obo:IAO_0000412>
