        <rdfs:label>time unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/oostt/dev/oostt.owl/OOSTT_00000125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/oostt/dev/oostt.owl/OOSTT_00000125">
        <rdfs:subClassOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#ObsoleteClass"/>
        <obo:IAO_0000115 xml:lang="en">A collection of humans, all of which bear both an orthopedic surgeon role and an orthopedic board eligibility role and participate in a trauma care process</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">John Judkins</obo:IAO_0000117>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000103"/>
        <rdfs:comment xml:lang="en">Initially, we used the SubClass restriction, with &apos;only&apos;  after &apos;is aggregate of&apos; as an equivalent to restriction, which fully defines this set. However, given the number of collections in OOSTT this negatively affected reasoning time. For our data management purposes having the restriction as an existential restriction is totally sufficient, so we go with this.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete_collection of board eligible orthopedic surgeons in trauma care</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/oostt/dev/oostt.owl/OOSTT_00000126 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/oostt/dev/oostt.owl/OOSTT_00000126">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000115 xml:lang="en">A role that inheres in a human being and is acquired by successfully completing an orthopedic residency.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">John Judkins</obo:IAO_0000117>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <rdfs:label xml:lang="en">orthopedic board eligibility role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/oostt/dev/oostt.owl/OOSTT_00000127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/oostt/dev/oostt.owl/OOSTT_00000127">
        <rdfs:subClassOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#ObsoleteClass"/>
        <obo:IAO_0000115 xml:lang="en">A collection of humans, all of which bear a neurosurgeon role and are designated as part of the trauma on call plan specification</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">John Judkins</obo:IAO_0000117>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000227"/>
        <rdfs:comment xml:lang="en">Initially, we used the SubClass restriction, with &apos;only&apos;  after &apos;is aggregate of&apos; as an equivalent to restriction, which fully defines this set. However, given the number of collections in OOSTT this negatively affected reasoning time. For our data management purposes having the restriction as an existential restriction is totally sufficient, so we go with this.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete_collection of trauma panel neurosurgeons</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/oostt/dev/oostt.owl/OOSTT_00000129 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/oostt/dev/oostt.owl/OOSTT_00000129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000041"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is about a person and that affirms that they have attended at the number of meeting of the trauma peer review committee meetings as required by the designating or verifying agency.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">John Judkins</obo:IAO_0000117>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:OOSTT_00000030 xml:lang="en">The record verifying that each specified member participates in the trauma quality improvement committee and attends the majority of meetings as required by the designating or verifying agency.</obo:OOSTT_00000030>
        <rdfs:comment xml:lang="en">Whether this requirement is fulfilled depends on the PIPS attendance record.</rdfs:comment>
        <rdfs:label xml:lang="en">record of participation in majority of trauma peer review committee meetings</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/oostt/dev/oostt.owl/OOSTT_00000131 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/oostt/dev/oostt.owl/OOSTT_00000131">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000207"/>
        <obo:IAO_0000115 xml:lang="en">A collection of trauma surgeons on a trauma service, that, while on call, participate in emergency health care processes that are not trauma related.</obo:IAO_0000115>
        <obo:IAO_0000117>John Judkins</obo:IAO_0000117>
        <obo:IAO_0000117>Mathias Brochhausen</obo:IAO_0000117>
        <obo:OOSTT_00000030 xml:lang="en">All  trauma surgeons who participate in acute care non-trauma-related surgery while on call for the trauma panel.</obo:OOSTT_00000030>
        <rdfs:label xml:lang="en">collection of trauma surgeons providing non-trauma emergency care on call</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/oostt/dev/oostt.owl/OOSTT_00000132 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/oostt/dev/oostt.owl/OOSTT_00000132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OOSTT_00000071"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A plan specification that describes means of relaying information about changes to workflows of providing care for injured patients to the members of the trauma program.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">John Judkins</obo:IAO_0000117>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:OOSTT_00000030 xml:lang="en">The policy that describes the method of sharing information about the care of injured patients to the collective or individual members of the trauma program, e.g., change in protocol or procedures and rationale.</obo:OOSTT_00000030>
        <rdfs:label xml:lang="en">trauma program communication policy about changes to trauma process</rdfs:label>
    </owl:Class>
    


    <!-- http://vivoweb.org/ontology/core#MedicalResidency -->

    <owl:Class rdf:about="http://vivoweb.org/ontology/core#MedicalResidency">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <obo:IAO_0000115 xml:lang="en">Residency is a stage of graduate medical training.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A part of graduate education where the graduate from a medical program practices medicine under the supervision of an attending physician. (OOSTT editor comment created by M. Brochhausen, Nov 9, 2016)</obo:IAO_0000116>
        <dc:source>http://vivoweb.org/sites/vivoweb.org/files/vivo-isf-public-1.6.owl</dc:source>
        <rdfs:label xml:lang="en">Medical Residency</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/efo/EFO_0004950 -->

    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0004950">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115>The point in time at which an individual was born.</obo:IAO_0000115>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <obo:IAO_0000412>http://www.ebi.ac.uk/efo/releases/v3.70.0/efo.owl</obo:IAO_0000412>
        <oboInOwl:hasDbXref>SNOMEDCT:184099003</oboInOwl:hasDbXref>
        <rdfs:label>date of birth</rdfs:label>
    </owl:Class>
    


