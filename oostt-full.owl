                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A disposition that inheres in some material entity and is such that that, if realized, it is realized by either some linguistic concretization-utilization process or some linguistic concretization-interpretation process.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">S. Clint Dowland</obo:IAO_0000117>
        <dc:contributor xml:lang="en">Mathias Brochhausen</dc:contributor>
        <dc:contributor xml:lang="en">Matthew Diller</dc:contributor>
        <dc:contributor xml:lang="en">William R. Hogan</dc:contributor>
        <rdfs:label xml:lang="en">linguistic competence</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OMRSE_00002069 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OMRSE_00002069">
