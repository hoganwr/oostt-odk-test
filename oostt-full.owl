        <oboInOwl:hasRelatedSynonym>increased-permeability pulmonary oedema</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>non-cardiogenic pulmonary edema</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>non-cardiogenic pulmonary oedema</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003005"/>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mondo#ABBREVIATION"/>
        <oboInOwl:id>MONDO:0006502</oboInOwl:id>
