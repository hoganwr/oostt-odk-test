        <obo:IAO_0000115 xml:lang="en">A deontic document act in which a patient is registered with a health care provider for the purpose of receiving care in an inpatient encounter.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Amanda Hicks</obo:IAO_0000117>
