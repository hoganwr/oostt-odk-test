    <!-- http://purl.obolibrary.org/obo/OOSTT_00000379 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
