        <oboInOwl:hasDbXref>MedDRA:10001052</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C3353</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ARDS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>acute respiratory distress syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shock lung</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>ALI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stiff lung</oboInOwl:hasRelatedSynonym>
