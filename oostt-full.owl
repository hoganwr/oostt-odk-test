    <!-- http://purl.obolibrary.org/obo/OOSTT_00000381 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OOSTT_00000381">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <obo:IAO_0000115 xml:lang="en">An identifier that denotes one or more external causes in addition to the primary external cause of an injury where necessary using an ICD-10 code.</obo:IAO_0000115>
        <obo:IAO_0000117>Emma Chappell</obo:IAO_0000117>
