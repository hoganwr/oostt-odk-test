        <obo:IAO_0000115 xml:lang="en">An organization that is part of the bearer of a health care provider organization role and that has members that all bearer of a healthcare provider role within that organization.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:OOSTT_00000030 xml:lang="en">All healtcare providers who have been credentialed by a healthcare organization to provide care to patients or to perform administrative functions, including oversight of patient care.</obo:OOSTT_00000030>
        <rdfs:label xml:lang="en">medical staff</rdfs:label>
    </owl:Class>
    


